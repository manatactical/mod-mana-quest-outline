#
# mod-mana-quest-outline configuration
#
# Server-side companion to the client's wxl-mana-unit-outline module. This module tells that module
# which visible units are quest givers and what kind of quest they hold, so the client can outline
# them without the player pointing at them. The client's own UI has no quest state for a unit that is
# merely nearby, and stock 3.3.5a has no C_QuestLog.GetUnitQuestInfo, so the answer has to come from
# here.
#

[worldserver]

########################################
# The questgiver sync
########################################

#
#    ManaQuestOutline.Enable
#        Description: Enable the module. With 0 the client module simply never hears about quest
#                     givers and only outlines the mouseover and target unit as before.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ManaQuestOutline.Enable = 1

#
#    ManaQuestOutline.PollIntervalMs
#        Description: How often, in milliseconds, a *moving* player's visible set may be re-resolved.
#                     This is what bounds the snappiness: a giver is outlined within this long of being
#                     walked into view. It is a floor, not a cadence -- an idle player is never
#                     re-resolved, and a player who is not moving is covered by the idle resend below.
#                     The send is skipped entirely when the set is unchanged, so lowering this costs
#                     CPU, not bandwidth. Values below 100 are raised to 100.
#        Default:     250
#

ManaQuestOutline.PollIntervalMs = 250

#
#    ManaQuestOutline.IdleIntervalMs
#        Description: Unconditional resend cadence, in milliseconds, on top of the movement poll. It is
#                     the safety net for the changes no movement reports: a quest handed in, a level or
#                     reputation threshold crossed, an NPC phasing in on top of the player. Must be at
#                     least PollIntervalMs; values below it are raised.
#        Default:     3000
#

ManaQuestOutline.IdleIntervalMs = 3000

#
#    ManaQuestOutline.MoveDistance
#        Description: How far, in yards, a player must have moved since their set was last resolved
#                     before movement triggers a new poll. Raising it makes a player who paces about
#                     cost less; lowering it makes small steps re-resolve sooner. 0 re-resolves on any
#                     movement report (down to the poll floor).
#        Default:     5.0
#

ManaQuestOutline.MoveDistance = 5.0

#
#    ManaQuestOutline.MaxPerSync
#        Description: Most quest givers sent in one sync. A busy hub has more givers in view than the
#                     client will ever outline, and every extra field grows the addon message, so the
#                     walk stops collecting once this many are collected. Raise it only if a crowded
#                     city keeps dropping givers you wanted.
#        Default:     48
#

ManaQuestOutline.MaxPerSync = 48